{
  "name": "codename-two",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.14",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @codename-two/web",
    "dev:site": "npm run dev --workspace @codename-two/site",
    "dev:api": "npm run dev --workspace @codename-two/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
